function doPost(e) {
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();

  sheet.appendRow([
    new Date(),
    e.parameter.customerName,
    e.parameter.waterConsumption,
    e.parameter.customerType,
    e.parameter.rate,
    e.parameter.amount,
    e.parameter.discountRate,
    e.parameter.discountAmount,
    e.parameter.totalAmount
  ]);

  return ContentService
    .createTextOutput("Success")
    .setMimeType(ContentService.MimeType.TEXT);
}
